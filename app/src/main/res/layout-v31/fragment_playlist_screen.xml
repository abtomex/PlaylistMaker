<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".media.ui.fragment.playlists.playlist_screen.PlaylistScreenFragment"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playlist_description_constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:nestedScrollingEnabled="true"
        android:orientation="vertical"
        tools:context=".media.ui.fragment.playlists.NewPlaylistFragment"
        >

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/leftBorder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="18dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/rightBorder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/new_playlist_fields_margins" />


        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/action_back"
            style="@style/header_style"
            android:layout_marginStart="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/back">

        </com.google.android.material.appbar.MaterialToolbar>

        <ImageView
            android:id="@+id/playlist_cover"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_no_image_placeholder_45"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            />

        <TextView
            android:id="@+id/playlist_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/ys_text_bold"
            android:text="@string/new_playlist_placeholder"
            android:textColor="@color/playlist_text_color"
            android:textSize="24sp"
            app:layout_constraintStart_toEndOf="@+id/leftBorder"
            app:layout_constraintTop_toBottomOf="@+id/playlist_cover" />

        <TextView
            android:id="@+id/playlist_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/ys_display_regular"
            android:text="@string/year_placeholder"
            android:textColor="@color/playlist_text_color"
            android:textSize="@dimen/playlist_info_text_size"
            app:layout_constraintStart_toEndOf="@+id/leftBorder"
            app:layout_constraintTop_toBottomOf="@+id/playlist_title" />

        <LinearLayout
            android:id="@+id/total_tracks_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@+id/leftBorder"
            app:layout_constraintTop_toBottomOf="@id/playlist_year">

            <TextView
                android:id="@+id/tracks_total_durability"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_regular"
                android:maxLines="1"
                android:text="@string/_300min_placeholder"
                android:textColor="@color/playlist_text_color"
                android:textSize="@dimen/playlist_info_text_size" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:src="@drawable/dark_dot_delimiter" />

            <TextView
                android:id="@+id/tracks_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_display_regular"
                android:text="@string/_98tracks_placeholder"
                android:textColor="@color/playlist_text_color"
                android:textSize="@dimen/playlist_info_text_size" />
        </LinearLayout>

        <ImageView
            android:id="@+id/button_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_share"
            app:layout_constraintStart_toEndOf="@+id/leftBorder"
            app:layout_constraintTop_toBottomOf="@id/total_tracks_info" />

        <ImageView
            android:id="@+id/button_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_more"
            app:layout_constraintStart_toEndOf="@+id/button_share"
            app:layout_constraintTop_toBottomOf="@id/total_tracks_info" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/standard_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="266dp"
        android:background="@color/bottom_sheet"
        android:orientation="vertical"
        app:behavior_hideable="true"
        android:gravity="center_horizontal"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        android:visibility="visible"
        android:layout_marginTop="24dp"
        >

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounder" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlists_recycler_view"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            />

    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>